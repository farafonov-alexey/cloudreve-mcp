# Cloudreve site (v4) — required
CLOUDREVE_BASE_URL=https://cloud.example.com

# OAuth application (Cloudreve admin → OAuth apps) — required
CLOUDREVE_CLIENT_ID=
CLOUDREVE_CLIENT_SECRET=

# OAuth endpoints (optional — defaults are derived from CLOUDREVE_BASE_URL)
# CLOUDREVE_AUTH_ENDPOINT=https://cloud.example.com/session/authorize
# CLOUDREVE_TOKEN_ENDPOINT=https://cloud.example.com/api/v4/session/oauth/token
# CLOUDREVE_REFRESH_ENDPOINT=https://cloud.example.com/api/v4/session/token/refresh
# CLOUDREVE_USERINFO_ENDPOINT=https://cloud.example.com/api/v4/session/oauth/userinfo

# Must match a Redirect URI registered on the OAuth app
CLOUDREVE_REDIRECT_URI=http://127.0.0.1:53682/callback

# Space-separated scopes. offline_access is required for refresh tokens.
# Exact file scope names may vary by Cloudreve version/edition — match your admin UI.
CLOUDREVE_SCOPES=openid profile offline_access Files.Read Files.Write Shares.Read Shares.Write

# Optional overrides
# CLOUDREVE_DOWNLOAD_ROOT=
# CLOUDREVE_CACHE_ROOT=
# CLOUDREVE_TOKEN_STORE=
# CLOUDREVE_CACHE_SECRET=
