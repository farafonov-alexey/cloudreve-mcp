{
  "name": "cloudreve-mcp",
  "version": "1.0.0",
  "description": "Cloudreve v4 MCP server with OAuth for Cursor",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "cloudreve-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "src",
    "tsconfig.json",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "mcp",
    "cloudreve",
    "cursor"
  ],
  "author": "SanderCokart",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SanderCokart/cloudreve-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/SanderCokart/cloudreve-mcp/issues"
  },
  "homepage": "https://github.com/SanderCokart/cloudreve-mcp#readme",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.1",
    "@types/node": "^24.3.0",
    "typescript": "^5.9.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "tsx": "^4.20.5",
    "vitest": "^3.2.4"
  }
}
